# Copy to .env and fill locally. This file intentionally contains no credentials.
POSTGRES_DB=fang_kee
POSTGRES_USER=fang_kee
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Required runtime secrets: generate unique values only in your local .env/deployment platform.
SECRET_KEY=
SEED_ADMIN_EMAIL=admin@fangkee.example
SEED_ADMIN_PASSWORD=
SEED_ON_START=true
SECURE_COOKIES=false
RETRIEVAL_THRESHOLD=0.08
CORS_ORIGINS=http://localhost:3000
DEMO_DATA_DIR=/app/demo-data
EVALUATION_REPORT_PATH=/app/evaluation-reports/evaluation-report.json

# Leave OPENAI_API_KEY empty for the no-cost deterministic local mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EVAL_API_URL=http://localhost:8000/api/chat
EVAL_API_TOKEN=
EVAL_EMAIL=
EVAL_PASSWORD=
# Optional JSON map, e.g. roles to separately provisioned evaluation accounts.
EVAL_CREDENTIALS_JSON=
EVAL_TIMEOUT_SECONDS=30
